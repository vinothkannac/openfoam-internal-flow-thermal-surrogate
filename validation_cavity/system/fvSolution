/*--------------------------------*- C++ -*----------------------------------*\
  SIMPLE solution control for the closed cavity (laminar).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p_rgh
    {
        solver          PCG;            // GAMG stalled at ~2e-6 (1000 its/step) on this closed cavity
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0.01;
    }

    "(U|h|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}

SIMPLE
{
    momentumPredictor           yes;
    nNonOrthogonalCorrectors    0;

    // closed domain: pressure level reference (ignored if the release reads it elsewhere)
    pRefCell                    0;
    pRefValue                   100000;
    pressureControl
    {
        pRefCell                0;
        pRefValue               100000;
    }

    residualControl
    {
        p_rgh           1e-6;
        U               1e-7;
        h               1e-8;
        e               1e-8;
    }
}

relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           0.7;
    }
    equations
    {
        U               0.3;
        "(h|e)"         0.3;
        ".*"            0.3;
    }
}
