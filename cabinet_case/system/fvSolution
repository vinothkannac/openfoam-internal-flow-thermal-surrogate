/*--------------------------------*- C++ -*----------------------------------*\
  SIMPLE solution control for the cabinet (k-omega SST, open domain).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-8;
        relTol          0.01;
    }

    "(U|h|e|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

SIMPLE
{
    momentumPredictor           yes;
    nNonOrthogonalCorrectors    1;     // unstructured Gmsh mesh

    residualControl
    {
        p_rgh               1e-4;
        U                   1e-5;
        "(h|e)"             1e-6;
        "(k|omega)"         1e-5;
    }
}

relaxationFactors
{
    fields
    {
        rho             1.0;
        p_rgh           0.7;
    }
    equations
    {
        U               0.15;
        "(h|e)"         0.15;
        "(k|omega)"     0.3;
        ".*"            0.3;
    }
}
