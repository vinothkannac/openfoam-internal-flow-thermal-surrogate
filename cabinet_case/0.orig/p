FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    "(inlet|outlet|walls|comp1|comp2|comp3)"
    {
        type            calculated;
        value           $internalField;
    }
    "(front|back)"
    {
        type            empty;
    }
}
