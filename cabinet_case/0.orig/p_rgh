FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    outlet
    {
        type            prghPressure;
        p               uniform 100000;
        value           $internalField;
    }
    "(walls|comp1|comp2|comp3)"
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    "(front|back)"
    {
        type            empty;
    }
}
