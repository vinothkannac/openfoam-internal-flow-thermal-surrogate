/*--------------------------------*- C++ -*----------------------------------*\
  RANS, k-omega SST with wall functions (low-Re inlet flow, buoyant plumes).
  ESI v2606 reads this file (not momentumTransport, which is the Foundation name).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

simulationType  RAS;

RAS
{
    model           kOmegaSST;
    turbulence      on;
    printCoeffs     on;
}
