/*--------------------------------*- C++ -*----------------------------------*\
  Air as ideal gas, constant mu, Cp, Pr. Weak compressibility (dT = 1 K) keeps
  the case close to the Boussinesq benchmark of de Vahl Davis.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   28.96;
    }
    thermodynamics
    {
        Cp          1005;
        Hf          0;
    }
    transport
    {
        mu          1.8e-5;
        Pr          0.71;
    }
}
